# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output and caches
/.next/
.next/cache/
/out/

# Production / build artifacts
/build/
/dist/

# Testing
/coverage/
/.nyc_output/
/jestcache/
/.vitest/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Environment variables (opt-in to commit if needed)
.env
.env.*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# Vercel / Netlify / Now
.vercel/
.netlify/
.now/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Editor directories and files
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Secrets / keys
*.pem
*.key
*.crt
.local

# Build and bundler caches
.cache/
.cache-loader/
.parcel-cache/
dist/
*.tgz

# Storybook
/storybook-static/

# Optional lockfiles (uncomment if you don't want to commit them)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Generated by package managers
.pnp/
.pnp.*

# Misc
*.swp
*.swo
*~.nib
*.bak

# Coverage and reports
reports/
*.lcov

# Supabase / local service files
supabase/.config
.supabase/

# Temporary files
tmp/
temp/
*.tmp

# Docker
docker-compose.override.yml
.env.docker

# Cypress
cypress/screenshots/
cypress/videos/

# Misc generated
coverage-report/

